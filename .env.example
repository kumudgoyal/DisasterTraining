# =============================================================================
# Real-Time Monitoring System for Disaster Management Trainings
# Academic Prototype — Environment Variables Template
# =============================================================================
# Copy this file to .env (never commit .env to git)
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/disaster_training_db"
# For PostGIS, the same URL works — PostGIS is an extension on the same DB

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Generate secure secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_64_char_random_hex_string_here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_ME_generate_another_64_char_random_hex_string"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV="development"
API_PORT=4000
API_HOST="0.0.0.0"

# Frontend URL (for CORS)
CORS_ORIGIN="http://localhost:3000"

# Log level: error | warn | info | debug
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# GEOCODING (Nominatim — free, no API key required)
# -----------------------------------------------------------------------------
GEOCODING_URL="https://nominatim.openstreetmap.org"
# Must include app name per Nominatim usage policy
GEOCODING_USER_AGENT="disaster-training-monitor/1.0 (academic-prototype)"

# -----------------------------------------------------------------------------
# REPORT STORAGE
# -----------------------------------------------------------------------------
# Local disk path for generated reports (PDF, XLSX, CSV)
# In production, replace with S3-compatible bucket credentials
REPORT_STORAGE_PATH="./storage/reports"

# -----------------------------------------------------------------------------
# ALERT ENGINE
# -----------------------------------------------------------------------------
# Cron expression for alert engine execution
# Default: every 15 minutes
ALERT_ENGINE_CRON="*/15 * * * *"

# Days without training before COVERAGE_GAP alert fires
ALERT_COVERAGE_GAP_DAYS=30

# Attendance % below which LOW_ATTENDANCE alert fires
ALERT_ATTENDANCE_THRESHOLD=60

# Days after training completion before MISSING_ASSESSMENT alert fires
ALERT_ASSESSMENT_DEADLINE_DAYS=7

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Integration API — stricter limit
INTEGRATION_RATE_LIMIT_MAX=100
INTEGRATION_RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# SUPER ADMIN SEED (used only during initial DB seed)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@disaster-training.gov.in"
SEED_ADMIN_PASSWORD="CHANGE_ME_strong_password_here"

# =============================================================================
# WEB FRONTEND (apps/web/.env.local)
# Copy the following into apps/web/.env.local
# =============================================================================
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"
NEXT_PUBLIC_APP_NAME="Disaster Training Monitor"
NEXT_PUBLIC_APP_VERSION="1.0.0-prototype"
