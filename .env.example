# =============================================================================
# Real-Time Monitoring System for Disaster Management Trainings
# Environment Variables Template
# =============================================================================
# Copy this file to .env in the root directory (never commit .env to git)
# For the web frontend, also copy NEXT_PUBLIC_* vars to apps/web/.env.local
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/disaster_training_db"

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Generate secure secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_64_char_random_hex_string_here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_ME_generate_another_64_char_random_hex_string"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV="development"
API_PORT=4000
API_HOST="0.0.0.0"

# Frontend URL (for CORS). Comma-separated for multiple origins.
CORS_ORIGIN="http://localhost:3000"

# Log level: error | warn | info | debug
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# GEOCODING (Nominatim — free, no API key required)
# -----------------------------------------------------------------------------
GEOCODING_URL="https://nominatim.openstreetmap.org"
GEOCODING_USER_AGENT="disaster-training-monitor/1.0"

# -----------------------------------------------------------------------------
# REPORT STORAGE
# -----------------------------------------------------------------------------
# Local disk path for generated reports (PDF, XLSX, CSV)
REPORT_STORAGE_PATH="./storage/reports"

# -----------------------------------------------------------------------------
# ALERT ENGINE
# -----------------------------------------------------------------------------
# Cron expression for alert engine execution (default: every 15 minutes)
ALERT_ENGINE_CRON="*/15 * * * *"
ALERT_COVERAGE_GAP_DAYS=30
ALERT_ATTENDANCE_THRESHOLD=60
ALERT_ASSESSMENT_DEADLINE_DAYS=7

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# SUPER ADMIN SEED (used only during initial DB seed)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@disaster-training.gov.in"
SEED_ADMIN_PASSWORD="CHANGE_ME_strong_password_here"

# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# -----------------------------------------------------------------------------
# NDMA INTEGRATION (configure when available)
# -----------------------------------------------------------------------------
NDMA_API_URL=""
NDMA_API_KEY=""
NDMA_SYNC_INTERVAL_MS=3600000

# -----------------------------------------------------------------------------
# STATE INTEGRATION (configure when available)
# -----------------------------------------------------------------------------
STATE_API_URL=""
STATE_API_KEY=""

# =============================================================================
# WEB FRONTEND (apps/web/.env.local)
# Copy these into apps/web/.env.local
# =============================================================================
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"
NEXT_PUBLIC_APP_NAME="Disaster Training Monitor"
